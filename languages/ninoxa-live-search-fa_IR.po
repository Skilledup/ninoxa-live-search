#, php-format
msgid "View more search results for: %s"
msgstr "دیدن نتایج بیشتر برای: %s"

#: includes/class-ninoxa-live-search-search.php:221
msgid "More results..."
msgstr "نتایج بیشتر..."

#: includes/class-ninoxa-live-search-settings.php:49
msgid "Ninoxa"
msgstr "نینوکسا"

#: includes/class-ninoxa-live-search-settings.php:104
#: includes/class-ninoxa-live-search-settings.php:596
#: includes/class-ninoxa-live-search-settings.php:627
msgid "Disabled"
msgstr "غیرفعال"

#: includes/class-ninoxa-live-search-settings.php:105
msgid "Focus the field and press the shortcut you want to use."
msgstr "روی فیلد کلیک کنید و ترکیب کلید های مورد نظرتان رو فشار دهید."

#: includes/class-ninoxa-live-search-settings.php:106
msgid "Listening for your shortcut."
msgstr "در انتظار فشردن کلید ها."

#: includes/class-ninoxa-live-search-settings.php:107
msgid "Shortcut captured. Save settings to apply it."
msgstr "میان‌ بر دریافت شد. لطفاً تنظیمات را ذخیره کنید."

#: includes/class-ninoxa-live-search-settings.php:108
msgid "Shortcut cleared. Save settings to keep it disabled."
msgstr "میان بر حذف شد. تنظیمات را ذخیره کنید تا میان بر غیرفعال شود."

#: includes/class-ninoxa-live-search-settings.php:109
msgid "Add one key besides Ctrl, Alt, Shift, or Cmd."
msgstr "بجز کنترل، شیفت، آلت یا کامند کلید دیگری را نیز فشار دهید."

#: includes/class-ninoxa-live-search-settings.php:110
#: includes/class-ninoxa-live-search-settings.php:704
msgid "Keyboard shortcut must contain one key and optional modifiers like Ctrl, Alt, Shift, or Cmd."
msgstr "میان‌بر صفحه کلید باید شامل یک کلید و تغییردهنده‌های اختیاری مانند Ctrl، Alt، Shift یا Cmd باشد."

#: includes/class-ninoxa-live-search-settings.php:136
msgid "AJAX-powered instant search results for your WordPress site."
msgstr "نتایج جستجوی فوری‌ای که توسط AJAX برای سایت وردپرس شما ارائه می‌شود."

#: includes/class-ninoxa-live-search-settings.php:194
msgid "Save settings"
msgstr "ذخیره تنظیمات"

#: includes/class-ninoxa-live-search-settings.php:619
msgid "Clear"
msgstr "حذف"

#: includes/class-ninoxa-live-search-settings.php:623
msgid "Focus the field and press the shortcut you want to use. Backspace or Delete clears it."
msgstr "روی فیلد کلیک کنید و میان‌بری که می‌خواهید استفاده کنید را فشار دهید. کلید Backspace یا Delete آن را حذف می‌کند."

#: includes/class-ninoxa-live-search-settings.php:626
msgid "Shown on search field"
msgstr "نمایش شده در فیلد جستجو"

#: includes/class-ninoxa-live-search-settings.php:150
#: includes/class-ninoxa-live-search-settings.php:753
msgid "General"
msgstr "عمومی"

#: includes/class-ninoxa-live-search-settings.php:754
msgid "Choose how visitors trigger and use live search."
msgstr "نحوه فعال‌سازی و استفاده از جستجوی زنده توسط بازدیدکنندگان را انتخاب کنید."

#: includes/class-ninoxa-live-search-settings.php:757
msgid "Loading indicators"
msgstr "نمایشگرهای بارگذاری"

#: includes/class-ninoxa-live-search-settings.php:758
msgid "Configure the visual feedback shown on the search field while results are loading."
msgstr "بازخورد بصری نمایش داده‌شده روی فیلد جستجو را هنگام بارگذاری نتایج پیکربندی کنید."

#: includes/class-ninoxa-live-search-settings.php:776
msgid "Keyboard shortcut"
msgstr "میان‌بر صفحه کلید"

#: includes/class-ninoxa-live-search-settings.php:778
msgid "Press keys"
msgstr "کلیدها را فشار دهید"

#: includes/class-ninoxa-live-search-settings.php:780
msgid "Allowed keys: letters (A–Z), digits (0–9), symbols (/ . , ; - = [ ] ' `), function keys (F1–F12), and named keys — Enter, Escape, Backspace, Delete, Tab, Space, Insert, Home, End, Page Up, Page Down, and arrows. Combine with Ctrl, Alt, Shift, or Cmd. Leave empty to disable the shortcut and its hint."
msgstr "کلیدهای مجاز: حروف (A–Z)، اعداد (0–9)، نمادها (/ . , ; - = [ ] ' `)، کلیدهای تابع (F1–F12)، و کلیدهای نام‌گذاری شده — Enter، Escape، Backspace، Delete، Tab، Space، Insert، Home، End، Page Up، Page Down، و کلیدهای جهتی. آن‌ها را با Ctrl، Alt، Shift یا Cmd ترکیب کنید. برای غیرفعال کردن میان‌بر و نکته آن، آن را خالی بگذارید."

#: includes/class-ninoxa-live-search-settings.php:794
msgid "Spinner"
msgstr "نشانگر چرخشی"

#: includes/class-ninoxa-live-search-settings.php:796
msgid "Show a spinning indicator inside the search field while loading"
msgstr "نمایش یک نشانگر چرخشی داخل فیلد جستجو هنگام بارگذاری"

#: includes/class-ninoxa-live-search-settings.php:800
msgid "Spinner position"
msgstr "موقعیت نشانگر چرخشی"

#: includes/class-ninoxa-live-search-settings.php:804

msgstr "راست"

#: includes/class-ninoxa-live-search-settings.php:805
msgid "Left"
msgstr "چپ"

#: includes/class-ninoxa-live-search-settings.php:807
msgid "Side of the search field where the spinner appears."
msgstr "سمت فیلد جستجو که نشانگر در آن ظاهر می‌شود."

#: includes/class-ninoxa-live-search-settings.php:811
msgid "Spinner color"
msgstr "رنگ نشانگر چرخشی"

#: includes/class-ninoxa-live-search-settings.php:814
msgid "Color of the spinning indicator arc."
msgstr "رنگ حلال نشانگر چرخشی."

#: includes/class-ninoxa-live-search-settings.php:818
msgid "Spinner size"
msgstr "اندازه نشانگر چرخشی"

#: includes/class-ninoxa-live-search-settings.php:822
msgid "Small (14 px)"
msgstr "کوچک (۱۴ پیکسل)"

#: includes/class-ninoxa-live-search-settings.php:823
msgid "Medium (16 px)"
msgstr "متوسط (۱۶ پیکسل)"

#: includes/class-ninoxa-live-search-settings.php:824
msgid "Large (20 px)"
msgstr "بزرگ (۲۰ پیکسل)"

#: includes/class-ninoxa-live-search-settings.php:829
msgid "Spinner offset"
msgstr "فاصله نشانگر چرخشی"

#: includes/class-ninoxa-live-search-settings.php:831
msgid "12"
msgstr "۱۲"

#: includes/class-ninoxa-live-search-settings.php:833
msgid "Distance from the left or right edge of the input in pixels."
msgstr "فاصله از لبهٔ چپ یا راست ورودی به پیکسل."

#: includes/class-ninoxa-live-search-settings.php:838
msgid "Light sweep"
msgstr "گذر نور"

#: includes/class-ninoxa-live-search-settings.php:840
msgid "Animate a light sweep across the search field while loading"
msgstr "نمایش یک پوشش نورانی روی فیلد جستجو هنگام بارگذاری"

#: includes/class-ninoxa-live-search-settings.php:844
msgid "Light sweep speed"
msgstr "سرعت گذر نور"

#: includes/class-ninoxa-live-search-settings.php:848
msgid "Fast"
msgstr "سریع"

#: includes/class-ninoxa-live-search-settings.php:849
msgid "Normal"
msgstr "معمولی"

#: includes/class-ninoxa-live-search-settings.php:850
msgid "Slow"
msgstr "کند"

#: includes/class-ninoxa-live-search-settings.php:852
msgid "Set how quickly the light sweep animation travels across the input."
msgstr "سرعت حرکت انیمیشن پوشش نور روی ورودی را تنظیم کنید."

#: includes/class-ninoxa-live-search-assets.php:93
#: includes/class-ninoxa-live-search-settings.php:162
msgid "Matching"
msgstr "تطابق"

#: includes/class-ninoxa-live-search-options.php:54
#: includes/class-ninoxa-live-search-settings.php:862
#: includes/class-ninoxa-live-search-settings.php:896
